# ==============================================================================
# MoodGraph Task 3B: Knowledge Graph Recommender Configuration
# ==============================================================================

# Neo4j Connection Settings
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=moodgraph_secret
NEO4J_DATABASE=neo4j

# Data Paths (Relative to repository root or absolute path)
MOODGRAPH_DATA_ROOT=data/moodgraph_processed_v1.0

# Execution Modes: "synthetic", "pilot", "full"
KG_IMPORT_MODE=synthetic

# Genome Tag Filtering Policy (Top-M highest relevance tags per movie)
KG_TAG_TOP_M=20

# Minimum rating threshold for positive preference: w(r) = max(0, (r - 3.0) / 2.0)
KG_MIN_LIKED_RATING=3.5

# Batch Processing Configuration
KG_BATCH_SIZE=5000

# Scoring Metapath Weights (Must sum to 1.0: alpha + beta + gamma = 1.0)
KG_WEIGHT_ALPHA_GENRE=0.35
KG_WEIGHT_BETA_GENOME=0.45
KG_WEIGHT_GAMMA_COLLAB=0.20

